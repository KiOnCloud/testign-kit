{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh\" fail-closed \"${CLAUDE_PLUGIN_ROOT}/hooks/git_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh\" fail-closed-secrets \"${CLAUDE_PLUGIN_ROOT}/hooks/secret_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh\" fail-open \"${CLAUDE_PLUGIN_ROOT}/hooks/ask_to_console.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
